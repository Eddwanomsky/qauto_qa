{
	"info": {
		"_postman_id": "c1f2e3d4-a5b6-7c8d-9e0f-1a2b3c4d5e6f",
		"name": "HW3",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth - Login",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Выполняем вход только на 1-й итерации",
							"if (pm.info.iteration > 0) {",
							"    pm.execution.skipRequest();",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.info.iteration === 0) {",
							"    pm.test('Login successful', function () {",
							"        pm.expect(pm.response.code).to.eql(200);",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"remember\": false\n}"
				},
				"url": {
					"raw": "https://qauto.forstudy.space/api/auth/signin",
					"protocol": "https",
					"host": ["qauto", "forstudy", "space"],
					"path": ["api", "auth", "signin"]
				}
			},
			"response": []
		},
		{
			"name": "profile validation",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const iterData = pm.iterationData.toObject() || {};",
							"if (iterData.profileName !== undefined) pm.variables.set('profileName', iterData.profileName);",
							"if (iterData.profileLastName !== undefined) pm.variables.set('profileLastName', iterData.profileLastName);",
							"if (iterData.profileCountry !== undefined) pm.variables.set('profileCountry', iterData.profileCountry);",
							"if (iterData.profileDateBirth !== undefined) pm.variables.set('profileDateBirth', iterData.profileDateBirth);",
							"if (iterData.expectedStatus !== undefined) pm.variables.set('expectedStatus', iterData.expectedStatus);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let jsonData = {};",
							"try { jsonData = pm.response.json(); } catch (e) {}",
							"const expectedStatus = Number(pm.variables.get('expectedStatus'));",
							"const testCase = pm.iterationData.get('case') || `iteration ${pm.info.iteration + 1}`;",
							"",
							"pm.test(`[${testCase}] expected status`, function () {",
							"    pm.expect(pm.response.code).to.eql(expectedStatus);",
							"});",
							"",
							"if (expectedStatus >= 200 && expectedStatus < 300) {",
							"    pm.test(`[${testCase}] profile updated`, function () {",
							"        pm.expect(jsonData.status).to.eql('ok');",
							"    });",
							"} else {",
							"    pm.test(`[${testCase}] validation error response`, function () {",
							"        pm.expect(pm.response.code).to.be.within(400, 499);",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"{{profileName}}\",\n  \"lastName\": \"{{profileLastName}}\",\n  \"country\": \"{{profileCountry}}\",\n  \"dateBirth\": \"{{profileDateBirth}}\"\n}"
				},
				"url": {
					"raw": "https://qauto.forstudy.space/api/users/profile",
					"protocol": "https",
					"host": ["qauto", "forstudy", "space"],
					"path": ["api", "users", "profile"]
				}
			},
			"response": []
		}
	]
}
