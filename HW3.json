          "script": {
            "exec": [
              "const today = new Date().toISOString().split('T')[0];\r",
              "pm.environment.set(\"expenseDate\", today);\r",
              "\r",
              "\r",
              "let previousMileage = Number(pm.environment.get(\"currentMileage\"));\r",
              "if (!previousMileage || isNaN(previousMileage)) {\r",
              "    previousMileage = 10000;\r",
              "}\r",
              "\r",
              "var mileageIncrement = Math.floor(Math.random() * (500 - 100 + 1)) + 100;\r",
              "var newMileage = previousMileage + mileageIncrement;\r",
              "\r",
              "pm.environment.set(\"currentMileage\", newMileage);\r",
              "\r",
              "var randomLiters = Math.floor(Math.random() * (50 - 10 + 1)) + 10;\r",
              "pm.environment.set(\"expenseLiters\", randomLiters);\r",
              "\r",
              "var randomCost = Math.floor(Math.random() * (2500 - 500 + 1)) + 500;\r",
              "pm.environment.set(\"expenseTotalCost\", randomCost);"
