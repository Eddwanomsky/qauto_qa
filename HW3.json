              "});\r",
              "\r",
              "pm.test(\"Expense added successfully\", function () {\r",
              "    pm.expect(jsonData.status).to.eql(\"ok\");\r",
              "    pm.expect(jsonData.data).to.be.an('object');\r",
              "    \r",
              "    let sentMileage = Number(pm.environment.get(\"currentMileage\"));\r",
              "    if (jsonData.data && jsonData.data.mileage && sentMileage) {\r",
              "        pm.expect(jsonData.data.mileage).to.eql(sentMileage);\r",
              "    }\r",
              "});"
