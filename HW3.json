    {
      "name": "edit",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "\r",
              "const names = [\"John\", \"Alice\", \"Bob\", \"Charlie\", \"Diana\", \"Ethan\", \"Fiona\", \"George\", \"Victoria\", \"Max\"];\r",
              "const lastNames = [\"Smith\", \"Doe\", \"Johnson\", \"Brown\", \"Taylor\", \"Miller\", \"Wilson\", \"Davis\"];\r",
              "const country = [\"Ukraine\", \"Spain\", \"US\", \"UK\", \"Romania\", \"Poland\"];\r",
              "\r",
              "const randomYear = Math.floor(Math.random() * (2005 - 1980 + 1)) + 1980;\r",
              "const randomMonth = String(Math.floor(Math.random() * 12) + 1).padStart(2, '0');\r",
              "\r",
              "const randomDay = String(Math.floor(Math.random() * 28) + 1).padStart(2, '0');\r",
              "const randomDateBirth = `${randomYear}-${randomMonth}-${randomDay}`;\r",
              "\r",
              "\r",
              "const newName = names[Math.floor(Math.random() * names.length)];\r",
              "const newLastName = lastNames[Math.floor(Math.random() * lastNames.length)];\r",
              "const newCountry = country[Math.floor(Math.random() * country.length)];\r",
              "\r",
              "pm.environment.set(\"dynamicName\", newName);\r",
              "pm.environment.set(\"dynamicLastName\", newLastName);\r",
              "pm.environment.set(\"dynamicCountry\", newCountry);\r",
              "pm.environment.set(\"dynamicDateBirth\", randomDateBirth);\r",
              "\r",
              "if (!pm.environment.get(\"dynamicPhoto\")) {\r",
              "    pm.environment.set(\"dynamicPhoto\", \"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = {};",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {",
              "    pm.test.fail(\"Response is not a valid JSON or empty\");",
              "}",
              "",
              "pm.test(\"Status code is 200 or 201\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test(\"Response status is ok\", function () {",
              "    pm.expect(jsonData).to.have.property(\"status\", \"ok\");",
              "    pm.expect(jsonData).to.have.property(\"data\");",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "});",
              "",
              "pm.test(\"DateBirth is valid and updated\", function () {",
              "    const receivedDateBirth = jsonData.data.dateBirth;",
              "    pm.expect(receivedDateBirth).to.be.a('string');",
              "",
              "    const dateOnly = receivedDateBirth.includes('T') ? receivedDateBirth.split('T')[0] : receivedDateBirth;",
              "    ",
              "    const dateRegex = /^\\d{4}-\\d{2}-\\d{2}$/;",
              "    pm.expect(dateOnly).to.match(dateRegex, \"dateBirth format is invalid\");",
              "",
              "    const sentDate = pm.environment.get(\"dynamicDateBirth\");",
              "    pm.expect(dateOnly).to.equal(sentDate);",
              "});",
              "",
              "pm.test(\"Response data matches request data fields\", function () {",
              "    const responseData = jsonData.data;",
              "",
              "    const expectedName = pm.environment.get(\"dynamicName\");",
              "    const expectedLastName = pm.environment.get(\"dynamicLastName\");",
              "    const expectedCountry = pm.environment.get(\"dynamicCountry\");",
              "    const expectedDateBirth = pm.environment.get(\"dynamicDateBirth\");",
              "    const expectedPhoto = pm.environment.get(\"dynamicPhoto\");",
              "",
              "    const responseDateOnly = responseData.dateBirth ? responseData.dateBirth.split('T')[0] : \"\";",
              "",
              "    if (expectedName) {",
              "        pm.expect(responseData.name).to.equal(expectedName);",
              "    }",
              "    if (expectedLastName) {",
              "        pm.expect(responseData.lastName).to.equal(expectedLastName);",
              "    }",
              "    if (expectedCountry) {",
              "        pm.expect(responseData.country).to.equal(expectedCountry);",
              "    }",
              "    if (expectedDateBirth) {",
              "        pm.expect(responseDateOnly).to.equal(expectedDateBirth);",
              "    }",
              "",
              "    if (expectedPhoto) {",
              "        if (responseData.photo) {",
              "            pm.expect(responseData.photo).to.equal(expectedPhoto);",
              "        } else {",
              "            console.warn(\"Server response does not contain 'photo' field\");",
              "        }",
              "    }",
              "});",
              "",
              "pm.test(\"Save userId to environment\", function () {",
              "    var userId = jsonData.data.userId || jsonData.data.id;",
              "    if (userId) {",
              "        pm.environment.set(\"userId\", userId);",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
