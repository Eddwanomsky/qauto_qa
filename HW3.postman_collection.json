              "listen": "prerequest",
              "script": {
                "exec": [
                  "const year = Math.floor(Math.random() * (2005 - 1980 + 1)) + 1980;",
                  "const month = String(Math.floor(Math.random() * 12) + 1).padStart(2, '0');",
                  "const day = String(Math.floor(Math.random() * 28) + 1).padStart(2, '0');",
                  "",
                  "pm.environment.set('dynamicName', pm.helpers.random(pm.helpers.names));",
                  "pm.environment.set('dynamicLastName', pm.helpers.random(pm.helpers.lastNames));",
                  "pm.environment.set('dynamicCountry', pm.helpers.random(pm.helpers.countries));",
                  "pm.environment.set('dynamicDateBirth', `${year}-${month}-${day}`);",
                  "",
                  "if (!pm.environment.get('dynamicPhoto')) {",
                  "    pm.environment.set('dynamicPhoto', pm.helpers.defaultPhoto);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.helpers.parseJson(pm.response.text());",
                  "pm.test('Status code is 200 or 201', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Profile update response is valid', () => {",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "});",
                  "const response = jsonData.data || {};",
                  "const date = response.dateBirth ? String(response.dateBirth).split('T')[0] : '';",
                  "pm.test('Response matches request', () => {",
                  "    pm.expect(response.name).to.eql(pm.environment.get('dynamicName'));",
                  "    pm.expect(response.lastName).to.eql(pm.environment.get('dynamicLastName'));",
                  "    pm.expect(response.country).to.eql(pm.environment.get('dynamicCountry'));",
                  "    pm.expect(date).to.eql(pm.environment.get('dynamicDateBirth'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
