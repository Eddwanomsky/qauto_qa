                  "let currentPassword = pm.environment.get(\"password\");\r",
                  "if (!currentPassword) {\r",
                  "    currentPassword = \"Password12345A\"; \r",
                  "}\r",
                  "pm.environment.set(\"oldPassword\", currentPassword);\r",
                  "\r",
                  "\r",
                  "var randomNum = Math.floor(Math.random() * 90000) + 10000;\r",
                  "var newPassword = \"Password\" + randomNum + \"A\";\r",
                  "pm.environment.set(\"password\", newPassword);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = {};\r",
                  "try {\r",
