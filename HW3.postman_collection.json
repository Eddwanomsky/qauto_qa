        "type": "text/javascript",
        "exec": [
          "pm.helpers = {",
          "    names: ['John', 'Alice', 'Bob', 'Charlie', 'Diana', 'Ethan', 'Fiona', 'George', 'Victoria', 'Max'],",
          "    lastNames: ['Smith', 'Doe', 'Johnson', 'Brown', 'Taylor', 'Miller', 'Wilson', 'Davis'],",
          "    countries: ['Ukraine', 'Spain', 'US', 'UK', 'Romania', 'Poland'],",
