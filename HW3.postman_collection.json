    {
      "name": "Validation",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const data = pm.iterationData.toObject();",
              "if (data.type && data.type !== 'register' && data.type !== 'profile') {",
              "    pm.execution.skipRequest();",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "item": [
        {
          "name": "register validation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const data = pm.iterationData.toObject();",
                  "if (data.type && data.type !== 'register') {",
                  "    pm.execution.skipRequest();",
                  "}",
                  "",
                  "pm.variables.set('baseUrl', pm.helpers.getValue(data, 'baseUrl', pm.environment.get('baseUrl') || ''));",
                  "pm.variables.set('testName', pm.helpers.getValue(data, 'name'));",
                  "pm.variables.set('testLastName', pm.helpers.getValue(data, 'lastName'));",
                  "",
                  "let rawEmail = pm.helpers.getValue(data, 'email');",
                  "let emailToSend = (rawEmail && rawEmail.trim() !== '') ",
                  "    ? rawEmail ",
                  "    : `auto_user_${pm.info.iteration}_${Date.now()}@test.com`;",
                  "",
                  "pm.variables.set('testEmail', emailToSend);",
                  "pm.variables.set('testPassword', pm.helpers.getValue(data, 'password'));",
                  "pm.variables.set('testRepeatPassword', pm.helpers.getValue(data, 'repeatPassword'));",
                  "",
                  "const expectedStatus = Number(pm.helpers.getValue(data, 'expectedStatus', 201));",
                  "pm.variables.set('expectedStatus', Number.isFinite(expectedStatus) ? expectedStatus : 201);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.helpers.parseJson(pm.response.text());",
                  "const expectedStatus = Number(pm.variables.get('expectedStatus'));",
                  "const testCase = pm.iterationData.get('case') || `iteration ${pm.info.iteration + 1}`;",
                  "",
                  "pm.test(`[${testCase}] expected status`, function () {",
                  "    if (Number.isNaN(expectedStatus)) {",
                  "        pm.expect(pm.response.code).to.be.within(400, 499);",
                  "    } else {",
                  "        pm.expect(pm.response.code).to.eql(expectedStatus);",
                  "    }",
                  "});",
                  "",
                  "if (expectedStatus >= 200 && expectedStatus < 300) {",
                  "    pm.test(`[${testCase}] successful registration`, function () {",
                  "        pm.expect(jsonData.status).to.eql('ok');",
                  "        pm.expect(jsonData.data).to.be.an('object');",
                  "    });",
                  "} else {",
                  "    pm.test(`[${testCase}] validation error response`, function () {",
                  "        pm.expect(pm.response.code).to.be.within(400, 499);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testName}}\",\n  \"lastName\": \"{{testLastName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"repeatPassword\": \"{{testRepeatPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          },
          "response": []
        },
        {
          "name": "profile validation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const data = pm.iterationData.toObject();",
                  "if (data.type && data.type !== 'profile') {",
                  "    pm.execution.skipRequest();",
                  "}",
                  "",
                  "pm.variables.set('baseUrl', pm.helpers.getValue(data, 'baseUrl', pm.environment.get('baseUrl') || ''));",
                  "pm.variables.set('profileName', pm.helpers.getValue(data, 'name', 'John'));",
                  "pm.variables.set('profileLastName', pm.helpers.getValue(data, 'lastName', 'Smith'));",
                  "pm.variables.set('profileCountry', pm.helpers.getValue(data, 'country', 'Ukraine'));",
                  "pm.variables.set('profileDateBirth', pm.helpers.getValue(data, 'dateBirth', '1995-05-15'));",
                  "pm.variables.set('profilePhoto', pm.helpers.getValue(data, 'photo', pm.helpers.defaultPhoto));",
                  "",
                  "const expectedStatus = Number(pm.helpers.getValue(data, 'expectedStatus', 200));",
                  "pm.variables.set('expectedStatus', Number.isFinite(expectedStatus) ? expectedStatus : 200);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.helpers.parseJson(pm.response.text());",
                  "const expectedStatus = Number(pm.variables.get('expectedStatus'));",
                  "const testCase = pm.iterationData.get('case') || `iteration ${pm.info.iteration + 1}`;",
                  "",
                  "pm.test(`[${testCase}] expected status`, function () {",
                  "    if (Number.isNaN(expectedStatus)) {",
                  "        pm.expect(pm.response.code).to.be.within(400, 499);",
                  "    } else {",
                  "        pm.expect(pm.response.code).to.eql(expectedStatus);",
                  "    }",
                  "});",
                  "",
                  "if (expectedStatus >= 200 && expectedStatus < 300) {",
                  "    pm.test(`[${testCase}] profile updated`, function () {",
                  "        pm.expect(jsonData.status).to.eql('ok');",
                  "        pm.expect(jsonData.data).to.be.an('object');",
                  "    });",
                  "",
                  "    pm.test(`[${testCase}] response matches input`, function () {",
                  "        if (jsonData.data && jsonData.data.name !== undefined) {",
                  "            pm.expect(jsonData.data.name).to.eql(pm.variables.get('profileName'));",
                  "        }",
                  "        if (jsonData.data && jsonData.data.lastName !== undefined) {",
                  "            pm.expect(jsonData.data.lastName).to.eql(pm.variables.get('profileLastName'));",
                  "        }",
                  "        if (jsonData.data && jsonData.data.country !== undefined) {",
                  "            pm.expect(jsonData.data.country).to.eql(pm.variables.get('profileCountry'));",
                  "        }",
                  "        if (jsonData.data && jsonData.data.dateBirth !== undefined) {",
                  "            const actualDate = String(jsonData.data.dateBirth).split('T')[0];",
                  "            pm.expect(actualDate).to.eql(pm.variables.get('profileDateBirth'));",
                  "        }",
                  "    });",
                  "} else {",
                  "    pm.test(`[${testCase}] validation error response`, function () {",
                  "        pm.expect(pm.response.code).to.be.within(400, 499);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo\": \"{{profilePhoto}}\",\n  \"name\": \"{{profileName}}\",\n  \"lastName\": \"{{profileLastName}}\",\n  \"dateBirth\": \"{{profileDateBirth}}\",\n  \"country\": \"{{profileCountry}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          },
          "response": []
        }
