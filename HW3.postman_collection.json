                  "\r",
                  "\r",
                  "pm.test(\"UserId matches the one from user creation\", function () {\r",
                  "    const expectedUserId = pm.environment.get(\"userId\");\r",
                  "    const responseUserId = jsonData.data.userId || jsonData.data.id;\r",
                  "    \r",
                  "    pm.expect(expectedUserId).to.not.be.undefined;\r",
                  "    pm.expect(responseUserId).to.not.be.undefined;\r",
                  "\r",
                  "\r",
