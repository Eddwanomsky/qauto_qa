      "name": "Validation",
      "item": [
        {
          "name": "register validation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.iterationData.toObject();\n\n// Пропуск запроса, если тип не 'register'\nif (data.type && data.type !== 'register') {\n    pm.execution.skipRequest();\n}\n\n// Безопасное получение значений из data\nvar getValue = function(obj, key, def) {\n    return (obj && obj[key] !== undefined && obj[key] !== null) ? obj[key] : def;\n};\n\npm.variables.set('baseUrl', getValue(data, 'baseUrl', pm.environment.get('baseUrl') || ''));\npm.variables.set('testName', getValue(data, 'name', ''));\npm.variables.set('testLastName', getValue(data, 'lastName', ''));\n\nvar rawEmail = getValue(data, 'email', '');\nvar emailToSend = (rawEmail && String(rawEmail).trim() !== '') \n    ? rawEmail \n    : `auto_user_${pm.info.iteration}_${Date.now()}@test.com`;\n\npm.variables.set('testEmail', emailToSend);\npm.variables.set('testPassword', getValue(data, 'password', ''));\npm.variables.set('testRepeatPassword', getValue(data, 'repeatPassword', ''));\n\nvar expStatus = Number(getValue(data, 'expectedStatus', 201));\npm.variables.set('expectedStatus', Number.isFinite(expStatus) ? expStatus : 201);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var expStatusCode = Number(pm.variables.get('expectedStatus'));\nvar testCase = pm.iterationData.get('case') || `iteration ${pm.info.iteration + 1}`;\n\n// Безопасный парсинг JSON-ответа\nvar jsonData = {};\ntry {\n    jsonData = pm.response.json();\n} catch (e) {\n    // Если ответ пришел не в формате JSON (например, 500 HTML или пустой)\n}\n\npm.test(`[${testCase}] expected status`, function () {\n    if (Number.isNaN(expStatusCode)) {\n        pm.expect(pm.response.code).to.be.within(400, 499);\n    } else {\n        pm.expect(pm.response.code).to.eql(expStatusCode);\n    }\n});\n\nif (expStatusCode >= 200 && expStatusCode < 300) {\n    pm.test(`[${testCase}] successful registration`, function () {\n        pm.expect(jsonData.status).to.eql('ok');\n        pm.expect(jsonData.data).to.be.an('object');\n    });\n} else {\n    pm.test(`[${testCase}] validation error response`, function () {\n        pm.expect(pm.response.code).to.be.within(400, 499);\n    });\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testName}}\",\n  \"lastName\": \"{{testLastName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"repeatPassword\": \"{{testRepeatPassword}}\"\n}",
