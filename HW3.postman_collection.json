                  "\r",
                  "var mileageIncrement = Math.floor(Math.random() * (500 - 100 + 1)) + 100;\r",
                  "var newMileage = previousMileage + mileageIncrement;\r",
                  "\r",
                  "pm.environment.set(\"currentMileage\", newMileage);\r",
                  "\r",
                  "var randomLiters = Math.floor(Math.random() * (50 - 10 + 1)) + 10;\r",
                  "pm.environment.set(\"expenseLiters\", randomLiters);\r",
