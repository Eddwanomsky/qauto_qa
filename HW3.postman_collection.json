          "    random: arr => arr[Math.floor(Math.random() * arr.length)],",
          "    getValue: (data, key, fallback = '') => Object.prototype.hasOwnProperty.call(data, key) ? data[key] : fallback,",
          "    parseJson: (text) => { try { return JSON.parse(text); } catch (e) { return {}; } }",
          "};",
          "",
          "const iterationBaseUrl = pm.iterationData.get('baseUrl');",
