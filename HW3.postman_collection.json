                  "pm.environment.set('dynamicEmail', `test_user_${randomNum}@test.com`);",
                  "pm.environment.set('dynamicName', pm.helpers.random(pm.helpers.names));",
                  "pm.environment.set('dynamicLastName', pm.helpers.random(pm.helpers.lastNames));",
                  "",
                  "if (!pm.environment.get('password')) {",
