        {
          "name": "profile validation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.iterationData.toObject();\n\n// Пропуск запроса, если тип не 'profile'\nif (data.type && data.type !== 'profile') {\n    pm.execution.skipRequest();\n}\n\n// Безопасное получение значений\nvar getValue = function(obj, key, def) {\n    return (obj && obj[key] !== undefined && obj[key] !== null) ? obj[key] : def;\n};\n\nvar defaultPhoto = (pm.helpers && pm.helpers.defaultPhoto) ? pm.helpers.defaultPhoto : '';\n\npm.variables.set('baseUrl', getValue(data, 'baseUrl', pm.environment.get('baseUrl') || ''));\npm.variables.set('profileName', getValue(data, 'name', 'John'));\npm.variables.set('profileLastName', getValue(data, 'lastName', 'Smith'));\npm.variables.set('profileCountry', getValue(data, 'country', 'Ukraine'));\npm.variables.set('profileDateBirth', getValue(data, 'dateBirth', '1995-05-15'));\npm.variables.set('profilePhoto', getValue(data, 'photo', defaultPhoto));\n\nvar expStatus = Number(getValue(data, 'expectedStatus', 200));\npm.variables.set('expectedStatus', Number.isFinite(expStatus) ? expStatus : 200);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var expStatusCode = Number(pm.variables.get('expectedStatus'));\nvar testCase = pm.iterationData.get('case') || `iteration ${pm.info.iteration + 1}`;\n\n// Безопасный парсинг JSON-ответа\nvar jsonData = {};\ntry {\n    jsonData = pm.response.json();\n} catch (e) {\n    // В случае пустой строки или некорректного JSON\n}\n\npm.test(`[${testCase}] expected status`, function () {\n    if (Number.isNaN(expStatusCode)) {\n        pm.expect(pm.response.code).to.be.within(400, 499);\n    } else {\n        pm.expect(pm.response.code).to.eql(expStatusCode);\n    }\n});\n\nif (expStatusCode >= 200 && expStatusCode < 300) {\n    pm.test(`[${testCase}] profile updated`, function () {\n        pm.expect(jsonData.status).to.eql('ok');\n        pm.expect(jsonData.data).to.be.an('object');\n    });\n\n    pm.test(`[${testCase}] response matches input`, function () {\n        if (jsonData.data && jsonData.data.name !== undefined) {\n            pm.expect(jsonData.data.name).to.eql(pm.variables.get('profileName'));\n        }\n        if (jsonData.data && jsonData.data.lastName !== undefined) {\n            pm.expect(jsonData.data.lastName).to.eql(pm.variables.get('profileLastName'));\n        }\n        if (jsonData.data && jsonData.data.country !== undefined) {\n            pm.expect(jsonData.data.country).to.eql(pm.variables.get('profileCountry'));\n        }\n        if (jsonData.data && jsonData.data.dateBirth !== undefined) {\n            var actualDate = String(jsonData.data.dateBirth).split('T')[0];\n            pm.expect(actualDate).to.eql(pm.variables.get('profileDateBirth'));\n        }\n    });\n} else {\n    pm.test(`[${testCase}] validation error response`, function () {\n        pm.expect(pm.response.code).to.be.within(400, 499);\n    });\n}"
                ]
              }
            }
          ],
