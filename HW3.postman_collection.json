  "item": [
    {
      "name": "Validation",
      "item": [
        {
          "name": "register validation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const data = pm.iterationData.toObject();",
                  "",
                  "if (data.type !== \"register\") {",
                  "    pm.execution.skipRequest();",
                  "}",
                  "",
                  "const value = (key, fallback = \"\") =>",
                  "    Object.prototype.hasOwnProperty.call(data, key) ? data[key] : fallback;",
                  "",
                  "pm.variables.set(\"baseUrl\", value(\"baseUrl\", pm.environment.get(\"baseUrl\") || \"\"));",
                  "pm.variables.set(\"testName\", value(\"name\"));",
                  "pm.variables.set(\"testLastName\", value(\"lastName\"));",
                  "",
                  "",
                  "let rawEmail = value(\"email\");",
                  "let emailToSend = (rawEmail && rawEmail.trim() !== \"\") ",
                  "    ? rawEmail ",
                  "    : `auto_user_${pm.info.iteration}_${Date.now()}@test.com`;",
                  "",
                  "pm.variables.set(\"testEmail\", emailToSend);",
                  "",
                  "pm.variables.set(\"testPassword\", value(\"password\"));",
                  "pm.variables.set(\"testRepeatPassword\", value(\"repeatPassword\"));",
                  "",
                  "const expectedStatus = Number(value(\"expectedStatus\", 201));",
                  "pm.variables.set(\"expectedStatus\", Number.isFinite(expectedStatus) ? expectedStatus : 201);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "let jsonData = {};",
                  "try {",
                  "    jsonData = pm.response.json();",
                  "} catch (e) {",
                  "    console.log(\"Response is not valid JSON or is empty\");",
                  "}",
                  "",
                  "const expectedStatus = Number(pm.variables.get(\"expectedStatus\"));",
                  "const testCase = pm.iterationData.get(\"case\") || `iteration ${pm.info.iteration + 1}`;",
                  "",
                  "pm.test(`[${testCase}] expected status`, function () {",
                  "    pm.expect(pm.response.code).to.eql(expectedStatus);",
                  "});",
                  "",
                  "if (expectedStatus >= 200 && expectedStatus < 300) {",
                  "    pm.test(`[${testCase}] successful registration`, function () {",
                  "        pm.expect(jsonData.status).to.eql(\"ok\");",
                  "        pm.expect(jsonData.data).to.be.an(\"object\");",
                  "    });",
                  "} else {",
                  "    pm.test(`[${testCase}] validation error response`, function () {",
                  "        pm.expect(pm.response.code).to.be.within(400, 499);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testName}}\",\n  \"lastName\": \"{{testLastName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"repeatPassword\": \"{{testRepeatPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
